{
  "name": "@nstudio/nativescript-compiler-angular",
  "version": "9.2.0-alpha.10",
  "description": "The Angular adapter of @nstudio/nativescript-compiler: compiles a NativeScript app written with Angular into a native iOS or Android app with no JavaScript runtime.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "runtime/",
    "kit-apple/",
    "kit-android/"
  ],
  "scripts": {
    "build": "ns-compiled-adapter build . && ns-compiled-adapter kit-fragment kit-apple",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nstudio/nativescript-compiler.git",
    "directory": "packages/angular"
  },
  "dependencies": {
    "@angular/compiler": "^22.2.1"
  },
  "peerDependencies": {
    "@nstudio/nativescript-compiler": "9.2.0-alpha.10"
  },
  "nativescript": {
    "compilerAdapter": {
      "apiVersion": 1,
      "detect": {
        "priority": 50,
        "dependencies": [
          "@nativescript/angular",
          "@angular/core"
        ],
        "entryMentions": [
          "@nativescript/angular",
          "@angular/core"
        ]
      },
      "testedVersions": {
        "@nativescript/angular": ">=22.0.0 <23.0.0",
        "@angular/core": ">=22.0.0 <23.0.0"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
