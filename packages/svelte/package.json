{
  "name": "@nstudio/nativescript-compiler-svelte",
  "version": "9.2.0-alpha.9",
  "description": "The Svelte adapter of @nstudio/nativescript-compiler: compiles a NativeScript app written with Svelte into a native iOS or Android app with no JavaScript runtime.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "ns-compiled-adapter build .",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nstudio/nativescript-compiler.git",
    "directory": "packages/svelte"
  },
  "dependencies": {
    "svelte": "^4.2.20"
  },
  "peerDependencies": {
    "@nstudio/nativescript-compiler": "9.2.0-alpha.9"
  },
  "nativescript": {
    "compilerAdapter": {
      "apiVersion": 1,
      "detect": {
        "priority": 40,
        "dependencies": [
          "@nativescript-community/svelte-native",
          "svelte"
        ],
        "entryMentions": [
          "svelte-native"
        ],
        "entryImports": [
          "svelte"
        ]
      },
      "testedVersions": {
        "@nativescript-community/svelte-native": ">=1.0.0 <2.0.0 || >=5.0.0-alpha.0 <6.0.0",
        "svelte": ">=4.2.0 <5.0.0 || >=5.50.0 <6.0.0"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
