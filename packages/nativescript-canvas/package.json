{
  "name": "@triniwiz/compiled-nativescript-canvas",
  "version": "9.2.0-alpha.11",
  "description": "The @nativescript/canvas binding of @nstudio/nativescript-compiler: the objects the plugin's native code installs into the JavaScript engine, in Swift and Kotlin over its native library, for an app compiled with no JavaScript engine.",
  "type": "module",
  "files": [
    "ios/",
    "ios.conditions.json",
    "android/"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nstudio/nativescript-compiler.git",
    "directory": "packages/nativescript-canvas"
  },
  "peerDependencies": {
    "@nstudio/nativescript-compiler": "9.2.0-alpha.11"
  },
  "nativescript": {
    "compilerBinding": {
      "apiVersion": 1,
      "package": "@nativescript/canvas",
      "versions": "^3.0.0-alpha.10",
      "ios": {
        "sources": "ios",
        "installer": "NSBinding_nativescript_canvas",
        "conditions": "ios.conditions.json"
      },
      "android": {
        "script": "android/canvas.ts",
        "kotlin": "android/kotlin",
        "jni": "android/jni",
        "installer": "org.nativescript.kit.canvas.NSBinding_nativescript_canvas",
        "stubs": [
          "canvasnativev8"
        ],
        "links": [
          {
            "lib": "canvasnative",
            "define": "CANVAS_NATIVE_LIBS"
          }
        ]
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "private": true
}
